{
  "version": 1,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 19,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "CANN operator Release build",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build_out",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ASCEND_COMPUTE_UNIT": "ascend910b",
        "vendor_name": "customize",
        "ENABLE_SOURCE_PACKAGE": true,
        "ENABLE_BINARY_PACKAGE": true,
        "ENABLE_TEST": false,
        "ASCEND_CANN_PACKAGE_PATH": "$env{ASCEND_HOME_PATH}",
        "ASCEND_PYTHON_EXECUTABLE": "python3",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build_out"
      }
    }
  ]
}
